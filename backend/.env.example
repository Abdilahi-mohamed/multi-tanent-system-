# PORT=4000
# MONGODB_URI=mongodb://127.0.0.1:27017/aura-commerce
# JWT_SECRET=replace-with-a-long-random-secret
# PAYMENT_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-bytes
# PAYMENT_CREDENTIAL_ENCRYPTION_KEY_ID=legacy
# During rotation, retain old key IDs here until the re-encryption command succeeds:
# PAYMENT_CREDENTIAL_ENCRYPTION_KEYRING={"legacy":"replace-with-the-prior-random-secret"}
# JWT_EXPIRES_IN=8h
# CLIENT_ORIGIN=http://localhost:3000
# SEED_DEMO_PASSWORD=replace-with-a-random-password-at-least-12-characters
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
